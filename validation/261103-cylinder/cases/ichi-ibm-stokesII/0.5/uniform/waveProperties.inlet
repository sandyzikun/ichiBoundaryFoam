FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       StokesII;
    location    "0.5/uniform";
    object      waveProperties.inlet;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

alpha           alpha.water;

waveModel       StokesII;

nPaddle         1;

waveHeight      0.05;

waveAngle       0;

rampTime        3;

activeAbsorption yes;

wavePeriod      3;

waterDepthRef   0.4;


// ************************************************************************* //
