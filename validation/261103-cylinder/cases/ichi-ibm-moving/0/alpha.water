FoamFile
{
    format      ascii;
    class       volScalarField;
    object      alpha.water;
}
dimensions      [0 0 0 0 0 0 0];
internalField   uniform 1;
boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 1;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 1;
        value           uniform 1;
    }
    topAndBottom
    {
        type            symmetry;
    }
    frontAndBack
    {
        type            empty;
    }
}

